# Copy to .env and fill in. .env is git-ignored - never commit it.

# ── Dashboard login (required) ───────────────────────────────
DASHBOARD_TITLE=Home Dashboard
DASHBOARD_USER=
DASHBOARD_PASS=
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Weather (Open-Meteo, no API key) ─────────────────────────
LOCATION_NAME=Your City, ST
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_TZ=America/New_York
UNITS=imperial            # imperial | metric

# ── Camera Pi (optional) ─────────────────────────────────────
CAMERA_STATS_URL=http://CAMERA_PI_IP:5001/api/stats
CAM_STREAM_URL=http://CAMERA_PI_IP:8080/?action=stream

# ── TP-Link Tapo smart devices (optional) ────────────────────
# Enable "Third-Party Compatibility" in the Tapo app and give each
# device a static IP / DHCP reservation on your router.
TAPO_EMAIL=
TAPO_PASSWORD=
TAPO_BULB_IP=             # L530 bulb
TAPO_PLUG_IP=             # P100 plug
TAPO_GROUP_IPS=           # comma-separated L530 bulbs, toggled together
TAPO_LAMP_IP=             # L530 bulb

# Names shown on the home page
LABEL_BULB=Light
LABEL_PLUG=Plug
LABEL_GROUP=Light Group
LABEL_LAMP=Lamp

# HOST=0.0.0.0
# PORT=5000
