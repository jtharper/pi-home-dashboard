# /etc/systemd/system/camera-stats.service  (camera Pi)
[Unit]
Description=Camera Pi stats server
After=network-online.target
Wants=network-online.target

[Service]
User=<USER>
WorkingDirectory=<INSTALL_DIR>/camera-pi
ExecStart=/usr/bin/python3 camera_stats.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
